PORT=3000
NODE_ENV=development

# Firebase Admin SDK — path to your service account JSON file downloaded from Firebase Console
# Go to: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# JWT secret used to sign QR verification tokens (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# QR token expiry (seconds) — default 24 hours
QR_TOKEN_EXPIRY_SECONDS=86400

# Firebase project ID (found in Firebase Console → Project Settings → General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Firebase Cloud Messaging server key (for push notifications)
# FCM_SERVER_KEY=your_fcm_server_key_here
